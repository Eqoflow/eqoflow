{
  "name": "WorkroomMessage",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "The ID of the MarketplaceTransaction this message belongs to."
    },
    "sender_email": {
      "type": "string",
      "description": "The email of the user who sent the message."
    },
    "sender_name": {
      "type": "string",
      "description": "The name of the user who sent the message."
    },
    "sender_avatar": {
      "type": "string",
      "description": "The avatar URL of the user who sent the message."
    },
    "content": {
      "type": "string",
      "description": "The content of the message."
    }
  },
  "required": [
    "transaction_id",
    "sender_email",
    "content"
  ]
}