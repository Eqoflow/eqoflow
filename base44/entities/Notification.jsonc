{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string",
      "description": "Email of the user receiving the notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "like",
        "comment",
        "repost",
        "follow",
        "message",
        "mention",
        "nft_access",
        "system",
        "reward",
        "flag"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Brief notification title"
    },
    "message": {
      "type": "string",
      "description": "Detailed notification message"
    },
    "actor_email": {
      "type": "string",
      "description": "Email of the user who triggered the notification"
    },
    "actor_name": {
      "type": "string",
      "description": "Name of the user who triggered the notification"
    },
    "actor_avatar": {
      "type": "string",
      "description": "Avatar URL of the user who triggered the notification"
    },
    "related_content_id": {
      "type": "string",
      "description": "ID of the post, comment, or other content related to this notification"
    },
    "related_content_type": {
      "type": "string",
      "enum": [
        "post",
        "comment",
        "message",
        "user",
        "skill",
        "stream",
        "feedback"
      ],
      "description": "Type of content this notification relates to"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the notification has been read"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the notification was read"
    },
    "action_url": {
      "type": "string",
      "description": "URL to navigate to when notification is clicked"
    },
    "metadata": {
      "type": "object",
      "description": "Additional data specific to the notification type",
      "properties": {
        "post_content_preview": {
          "type": "string"
        },
        "comment_content": {
          "type": "string"
        },
        "message_preview": {
          "type": "string"
        },
        "follower_count": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "recipient_email",
    "type",
    "message",
    "actor_email",
    "actor_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}