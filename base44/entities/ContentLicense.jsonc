{
  "name": "ContentLicense",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "License name (e.g., 'All Rights Reserved', 'Attribution Required')"
    },
    "short_code": {
      "type": "string",
      "description": "Short identifier code (e.g., 'ARR', 'CC-BY')"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what this license allows and restricts"
    },
    "terms": {
      "type": "object",
      "description": "Structured licensing terms",
      "properties": {
        "commercial_use": {
          "type": "boolean",
          "default": false,
          "description": "Whether commercial use is allowed"
        },
        "modification": {
          "type": "boolean",
          "default": false,
          "description": "Whether modifications/derivatives are allowed"
        },
        "distribution": {
          "type": "boolean",
          "default": false,
          "description": "Whether redistribution is allowed"
        },
        "attribution_required": {
          "type": "boolean",
          "default": true,
          "description": "Whether attribution to creator is required"
        },
        "share_alike": {
          "type": "boolean",
          "default": false,
          "description": "Whether derivatives must use same license"
        },
        "ai_training": {
          "type": "boolean",
          "default": false,
          "description": "Whether content can be used for AI model training"
        }
      }
    },
    "icon": {
      "type": "string",
      "description": "Icon identifier for UI display"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the default license for new content"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this license is currently available for selection"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in license selection UI"
    }
  },
  "required": [
    "name",
    "description",
    "terms"
  ]
}