{
  "name": "Course",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Course title"
    },
    "description": {
      "type": "string",
      "description": "Detailed course description"
    },
    "category": {
      "type": "string",
      "enum": [
        "technology",
        "business",
        "design",
        "marketing",
        "art",
        "music",
        "health",
        "languages",
        "personal_development",
        "other"
      ],
      "description": "Course category"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords for the course"
    },
    "price_amount": {
      "type": "number",
      "default": 0,
      "description": "Price of the course (0 for free)"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "GBP",
        "QFLOW"
      ],
      "default": "USD",
      "description": "Currency for the course price"
    },
    "external_url": {
      "type": "string",
      "description": "URL to external course content (YouTube, Udemy, personal website, etc.)"
    },
    "internal_media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs to internally uploaded content (videos, PDFs, etc.)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL for the course cover image"
    },
    "creator_email": {
      "type": "string",
      "description": "Email of the user who listed the course"
    },
    "creator_name": {
      "type": "string",
      "description": "Name of the user who listed the course"
    },
    "creator_avatar": {
      "type": "string",
      "description": "Avatar of the course creator"
    },
    "duration_hours": {
      "type": "number",
      "description": "Estimated duration in hours"
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "all_levels"
      ],
      "default": "all_levels",
      "description": "Difficulty level of the course"
    },
    "upload_plan_tier": {
      "type": "string",
      "enum": [
        "free",
        "tutor",
        "master"
      ],
      "default": "free",
      "description": "The plan tier used by the creator to list this course"
    },
    "platform_fee_percentage": {
      "type": "number",
      "default": 10,
      "description": "Percentage taken by EqoFlow on course sales"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "inactive",
        "rejected"
      ],
      "default": "active",
      "description": "Course status for moderation"
    },
    "enrolled_count": {
      "type": "number",
      "default": 0,
      "description": "Number of students enrolled"
    },
    "average_rating": {
      "type": "number",
      "default": 0,
      "description": "Average rating from reviews"
    },
    "reviews_count": {
      "type": "number",
      "default": 0,
      "description": "Number of reviews"
    },
    "total_revenue": {
      "type": "number",
      "default": 0,
      "description": "Total revenue generated by this course (before platform fees)"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this course is featured (promoted)"
    },
    "what_you_will_learn": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key learning outcomes/objectives"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Prerequisites for taking the course"
    },
    "target_audience": {
      "type": "string",
      "description": "Who this course is for"
    }
  },
  "required": [
    "title",
    "description",
    "category",
    "creator_email"
  ],
  "rls": {
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}