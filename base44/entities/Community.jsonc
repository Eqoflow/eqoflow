{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The unique name of the community"
    },
    "description": {
      "type": "string",
      "description": "A detailed description of the community"
    },
    "logo_url": {
      "type": "string",
      "description": "URL for the community's logo"
    },
    "banner_url": {
      "type": "string",
      "description": "URL for the community's banner image"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "gaming",
        "education",
        "music",
        "technology",
        "art",
        "fitness",
        "business",
        "entertainment",
        "support"
      ],
      "default": "general",
      "description": "The primary category of the community for discovery filtering"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "voice",
              "announcement"
            ],
            "description": "Channel type: text for text chat, voice for voice/video, announcement for admin-only posts"
          },
          "description": {
            "type": "string"
          },
          "position": {
            "type": "number"
          },
          "is_private": {
            "type": "boolean",
            "default": false
          },
          "settings": {
            "type": "object",
            "properties": {
              "mute_on_join": {
                "type": "boolean",
                "default": false
              },
              "require_permission_to_speak": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "voice_participants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "avatar_url": {
                  "type": "string"
                },
                "isVideoOn": {
                  "type": "boolean",
                  "default": false
                },
                "isSharing": {
                  "type": "boolean",
                  "default": false
                },
                "isMuted": {
                  "type": "boolean",
                  "default": false
                }
              }
            },
            "description": "List of users currently in this voice channel"
          }
        }
      },
      "description": "The channels (text, voice, announcement) within this community"
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of emails of the community members"
    },
    "banned_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of emails of users who are banned from this community"
    },
    "access_type": {
      "type": "string",
      "enum": [
        "public",
        "private_invite"
      ],
      "default": "public",
      "description": "Whether the community is publicly visible or invite-only"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique invite code for private communities"
    },
    "pricing_model": {
      "type": "string",
      "enum": [
        "free",
        "paid"
      ],
      "default": "free",
      "description": "Whether the community is free or paid"
    },
    "membership_fee": {
      "type": "number",
      "default": 0,
      "description": "Membership fee amount"
    },
    "currency": {
      "type": "string",
      "enum": [
        "QFLOW",
        "USD",
        "GBP",
        "EUR"
      ],
      "default": "USD",
      "description": "Currency for fiat or token payments"
    },
    "subscription_type": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly",
        "yearly"
      ],
      "default": "one_time",
      "description": "Billing frequency for paid communities"
    },
    "free_trial_days": {
      "type": "number",
      "default": 0,
      "description": "Free trial period in days for paid communities"
    },
    "total_revenue": {
      "type": "number",
      "default": 0,
      "description": "Total revenue generated by the community"
    },
    "active_subscribers": {
      "type": "number",
      "default": 0,
      "description": "Number of active paying members"
    },
    "media_gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          }
        }
      },
      "description": "A gallery of images and videos for the community page."
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Whether this community is pinned by admin to the top of the communities page"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags to help users discover the community based on interests."
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this community is currently featured as a paid promotion."
    },
    "featured_until": {
      "type": "string",
      "format": "date-time",
      "description": "The date and time until which this community is featured."
    },
    "landing_page_perks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Custom perks displayed on the landing page for non-members"
    },
    "landing_page_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of images to showcase on the landing page for non-members"
    },
    "widget_config": {
      "type": "object",
      "properties": {
        "left": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "right": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Configuration for which widgets appear in left and right sidebars"
    }
  },
  "required": [
    "name",
    "description"
  ],
  "rls": {
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}